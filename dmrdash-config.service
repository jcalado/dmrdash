[Unit]
Description=Apply an MMDVM.ini edit requested by the DMRHost dashboard
# config.py reads MMDVM.ini with its passwords masked, or applies an edit made against the exact file it finds, keeps the
# old file beside it, and restarts DMRHost.
# Opening the editor and writing are several quick requests; systemd's default (5 starts in 10 s) would trip on them and
# leave the path unit failed. Each request is removed as it is read, so this only stops a runaway, within a minute.
StartLimitIntervalSec=60
StartLimitBurst=60

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/dmrdash/config.py
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
