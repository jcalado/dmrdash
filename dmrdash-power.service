[Unit]
Description=Restart or shut down the Pi, or restart DMRHost, as requested by the DMRHost dashboard
# power.py takes one word from the request: "reboot" or "poweroff" goes to systemctl, "dmrhost" restarts the hotspot unit.

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/dmrdash/power.py
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
