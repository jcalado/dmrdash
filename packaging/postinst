#!/bin/sh
set -e
CONF=/etc/dmrdash.conf
SOURCES=/etc/apt/sources.list.d/dmrdash.sources
PATHS="dmrdash-rxoffset.path dmrdash-master.path dmrdash-power.path dmrdash-rflevel.path dmrdash-update.path"
if [ "$1" = configure ]; then
  id dmrdash >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin dmrdash
  if [ ! -f "$CONF" ]; then
    install -m 0640 -g dmrdash /usr/share/doc/dmrdash/dmrdash.conf.example "$CONF"
    for ini in /etc/MMDVM.ini /etc/mmdvmhost /etc/MMDVMHost.ini; do
      [ -r "$ini" ] || continue
      ID=$(awk -F= '/^\[/{s=$0} s=="[General]" && $1=="Id"{gsub(/[^0-9]/,"",$2); print $2; exit}' "$ini")
      [ -n "$ID" ] && sed -i "s/\"device_id\": 0,/\"device_id\": $ID,/" "$CONF" && break
    done
    echo "dmrdash: add your SelfCare API key (and optionally a PIN) to $CONF, then: sudo systemctl restart dmrdash"
  fi
  chown root:dmrdash "$CONF" && chmod 0640 "$CONF"
  # the apt source for updates, rewritten each time so a new release can move it; "Enabled: no" is kept
  OFF=$(grep -sx 'Enabled: no' "$SOURCES" || true)
  { cat /usr/share/dmrdash/dmrdash.sources; [ -z "$OFF" ] || echo "$OFF"; } > "$SOURCES.new"
  chmod 0644 "$SOURCES.new" && mv "$SOURCES.new" "$SOURCES"
  rm -f /usr/local/bin/dmrdash-tui  # install.sh's link; the package's is in /usr/bin
  # a unit left by install.sh would shadow the packaged one
  if grep -q '^Description=DMRHost dashboard' /etc/systemd/system/dmrdash.service 2>/dev/null; then
    rm -f /etc/systemd/system/dmrdash.service
  fi
  for u in dmrdash-rxoffset.path dmrdash-rxoffset.service dmrdash-master.path dmrdash-master.service dmrdash-power.path dmrdash-power.service dmrdash-rflevel.path dmrdash-rflevel.service; do
    grep -q 'DMRHost dashboard' "/etc/systemd/system/$u" 2>/dev/null && rm -f "/etc/systemd/system/$u"
  done
  # enabling works offline too (an image build, a container); starting needs a running systemd
  # shellcheck disable=SC2086
  systemctl enable dmrdash $PATHS >/dev/null 2>&1
  if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl restart dmrdash
    # shellcheck disable=SC2086
    systemctl start $PATHS
  fi
fi
