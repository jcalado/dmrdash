[Unit]
Description=Watch for MMDVM.ini edits from the DMRHost dashboard

[Path]
# PathExists, not PathChanged: a request written while config.py is still busy with the last one is picked up
# when it finishes (systemd checks again then). config.py removes each request as it reads it.
PathExists=/var/lib/dmrdash/config.request
Unit=dmrdash-config.service

[Install]
WantedBy=paths.target
