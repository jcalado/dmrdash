[Unit]
Description=Apply an RF power level requested by the DMRHost dashboard
# rflevel.py takes one percentage from the request, edits only RFLevel= in MMDVM.ini, and restarts DMRHost.

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/dmrdash/rflevel.py
NoNewPrivileges=yes
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
